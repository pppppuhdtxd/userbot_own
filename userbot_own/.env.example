# userbot_own/.env.example
# ════════════════════════════════════════════════════════════════
# Copy this file to userbot_own/.env and adjust as needed. Every value
# shown here is also the built-in default — an empty/missing .env
# file is perfectly fine.
#
# NOTE: this file did not exist in the pre-refactor project (the .env
# support itself is unchanged — it's simply undocumented there). Added
# here purely as documentation of the existing, already-supported
# variables; nothing about how they're read has changed.
# ════════════════════════════════════════════════════════════════

# Initial reconnect back-off, in seconds.
BACKOFF_START=1

# Maximum reconnect back-off, in seconds.
BACKOFF_MAX=300

# Maximum number of messages scanned by clearer / auto_clearer modules.
HISTORY_LIMIT=2000

# Root logging level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=DEBUG
